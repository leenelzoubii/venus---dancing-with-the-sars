# Normalise line endings so the repo behaves the same on Windows, macOS and Linux.
* text=auto eol=lf

# Binary / data formats must never be line-ending converted.
*.h5   binary
*.hdf5 binary
*.nc   binary
*.npy  binary
*.npz  binary
*.tif  binary
*.tiff binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary

# Windows scripts keep CRLF for older shells.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
