# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---------- Environments ----------
.venv/
venv/
env/
.conda/

# ---------- Credentials — NEVER commit ----------
_netrc
.netrc
.netrc.*
.edl_token*
*.pem
*.key
.env
.env.*
secrets.json
cookie*.txt

# ---------- Data (large; regenerated by the pipeline) ----------
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep

# NISAR / radar products by extension, wherever they land
*.h5
*.hdf5
*.nc
*.tif
*.tiff
*.vrt

# Keep small web deliverables (these ARE the product)
!web/assets/**

# ---------- Notebooks ----------
.ipynb_checkpoints/
*.ipynb.autosave

# ---------- Tooling / OS ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs / scratch ----------
*.log
scratch/
